{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/tts.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/navidad",
      "destination": "/navidad-2026.html"
    },
    {
      "source": "/navidad/",
      "destination": "/navidad-2026.html"
    }
  ]
}
